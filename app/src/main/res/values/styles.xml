<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!-- Testi -->
	<style name="TextArcade">
		<item name="android:textColor">@color/arcade_text</item>
		<item name="android:fontFamily">@font/press_start_2p</item>
	</style>

	<style name="TextArcade.Title" parent="TextArcade">
		<item name="android:textSize">24sp</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="TextArcade.Subtitle" parent="TextArcade">
		<item name="android:textSize">16sp</item>
	</style>

	<!-- Pulsanti stile arcade: outline verde, sfondo trasparente, spigoli 90° -->
	<style name="ButtonArcade" parent="Widget.MaterialComponents.Button.OutlinedButton">
		<item name="android:textAllCaps">false</item>
		<item name="android:textColor">@color/arcade_text</item>
		<item name="android:fontFamily">@font/press_start_2p</item>
		<item name="android:textSize">14sp</item>
		<item name="strokeColor">@color/arcade_text</item>
		<item name="strokeWidth">2dp</item>
		<item name="backgroundTint">@android:color/transparent</item>
		<item name="cornerRadius">0dp</item>
		<item name="android:minHeight">40dp</item>
		<item name="android:insetTop">4dp</item>
		<item name="android:insetBottom">4dp</item>
	</style>

</resources>


