<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:background="@color/arcade_bg"
              android:padding="4dp">

    <com.game.omino.render.GameSurfaceView
            android:id="@+id/game_surface"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    <!-- Barra dei comandi con GridLayout -->
    <GridLayout
            android:id="@+id/control_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="4dp"
            android:rowCount="2"
            android:columnCount="3">

        <!-- Pulsante sinistra -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_left"
                android:layout_width="@dimen/arcade_button_ctrl_width"
                android:layout_height="@dimen/arcade_button_height"
                android:text="←"
                style="@style/ButtonArcade"
                android:layout_row="0"
                android:layout_column="0"/>

        <!-- Pulsante su -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_up"
                android:layout_width="@dimen/arcade_button_ctrl_width_big"
                android:layout_height="@dimen/arcade_button_height"
                android:text="↑"
                style="@style/ButtonArcade"
                android:layout_row="0"
                android:layout_column="1"/>

        <!-- Pulsante destra -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_right"
                android:layout_width="@dimen/arcade_button_ctrl_width"
                android:layout_height="@dimen/arcade_button_height"
                android:text="→"
                style="@style/ButtonArcade"
                android:layout_row="0"
                android:layout_column="2"/>

        <!-- Pulsante fuoco sinistra -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_fire_left"
                android:layout_width="@dimen/arcade_button_ctrl_width"
                android:layout_height="@dimen/arcade_button_height"
                android:text="*"
                style="@style/ButtonArcade"
                android:layout_row="1"
                android:layout_column="0"/>

        <!-- Pulsante giù -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_down"
                android:layout_width="@dimen/arcade_button_ctrl_width_big"
                android:layout_height="@dimen/arcade_button_height"
                android:text="↓"
                style="@style/ButtonArcade"
                android:layout_row="1"
                android:layout_column="1"/>

        <!-- Pulsante fuoco destra -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_fire_right"
                android:layout_width="@dimen/arcade_button_ctrl_width"
                android:layout_height="@dimen/arcade_button_height"
                android:text="*"
                style="@style/ButtonArcade"
                android:layout_row="1"
                android:layout_column="2"/>

    </GridLayout>

</LinearLayout>