<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:background="@color/arcade_bg"
              android:padding="4dp">

    <com.game.omino.render.GameSurfaceView
            android:id="@+id/game_surface"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
    />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <TextView
                android:id="@+id/level_txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="level "
                android:gravity="center"
                android:padding="8dp"/>

        <TextView
                android:id="@+id/lives_txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="lives "
                android:gravity="center"
                android:padding="8dp"/>

        <TextView
                android:id="@+id/score_txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="score "
                android:gravity="center"
                android:padding="8dp"/>
    </LinearLayout>

    <!-- Barra dei comandi con GridLayout -->
    <GridLayout
            android:id="@+id/control_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="4dp"
            android:rowCount="2"
            android:columnCount="3"
            android:visibility="gone"
    >

        <!-- Pulsante sinistra -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_left"
                android:layout_width="@dimen/arcade_button_ctrl_width"
                android:layout_height="@dimen/arcade_button_height"
                android:text="←"
                style="@style/ButtonArcade"
                android:layout_row="0"
                android:layout_column="0"/>

        <!-- Pulsante su -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_up"
                android:layout_width="@dimen/arcade_button_ctrl_width_big"
                android:layout_height="@dimen/arcade_button_height"
                android:text="↑"
                style="@style/ButtonArcade"
                android:layout_row="0"
                android:layout_column="1"/>

        <!-- Pulsante destra -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_right"
                android:layout_width="@dimen/arcade_button_ctrl_width"
                android:layout_height="@dimen/arcade_button_height"
                android:text="→"
                style="@style/ButtonArcade"
                android:layout_row="0"
                android:layout_column="2"/>

        <!-- Pulsante fuoco sinistra -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_fire_left"
                android:layout_width="@dimen/arcade_button_ctrl_width"
                android:layout_height="@dimen/arcade_button_height"
                android:text="*"
                style="@style/ButtonArcade"
                android:layout_row="1"
                android:layout_column="0"/>

        <!-- Pulsante giù -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_down"
                android:layout_width="@dimen/arcade_button_ctrl_width_big"
                android:layout_height="@dimen/arcade_button_height"
                android:text="↓"
                style="@style/ButtonArcade"
                android:layout_row="1"
                android:layout_column="1"/>

        <!-- Pulsante fuoco destra -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/button_fire_right"
                android:layout_width="@dimen/arcade_button_ctrl_width"
                android:layout_height="@dimen/arcade_button_height"
                android:text="*"
                style="@style/ButtonArcade"
                android:layout_row="1"
                android:layout_column="2"/>

    </GridLayout>

    <FrameLayout
            android:id="@+id/game_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/arcade_bg">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:background="@color/arcade_bg"
                android:padding="16dp"
                android:layout_margin="16dp"
                android:gravity="center">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/gameover_button"
                    style="@style/ButtonArcade"
                    android:layout_width="@dimen/arcade_button_width"
                    android:layout_height="@dimen/arcade_button_height"
                    android:visibility="gone"
                    android:text="@string/game_over"/>
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/gamefinish_button"
                    style="@style/ButtonArcade"
                    android:layout_width="@dimen/arcade_button_width"
                    android:layout_height="@dimen/arcade_button_height"
                    android:visibility="gone"
                    android:text="@string/game_finish"/>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>